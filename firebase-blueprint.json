{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "User task synchronized across devices",
      "type": "object",
      "properties": {
        "cloudId": { "type": "string", "description": "Unique UUID for the task in the cloud" },
        "title": { "type": "string", "description": "Task title" },
        "description": { "type": "string", "description": "Task description" },
        "dueDate": { "type": "integer", "description": "Epoch timestamp in milliseconds for due date" },
        "dueTime": { "type": "string", "description": "Due time string" },
        "isCompleted": { "type": "boolean", "description": "Whether the task is completed" },
        "category": { "type": "string", "description": "Category name" },
        "priority": { "type": "string", "description": "Priority level" },
        "reminderTime": { "type": "integer", "description": "Epoch timestamp in milliseconds for reminder" },
        "isRepeat": { "type": "boolean", "description": "Whether task repeats" },
        "repeatType": { "type": "string", "description": "Repeat type frequency" },
        "displayOrder": { "type": "integer", "description": "Order position" },
        "subtasksJson": { "type": "string", "description": "Serialized JSON array of subtasks" },
        "attachedImageUri": { "type": "string", "description": "Local URI of attached image" },
        "isDeleted": { "type": "boolean", "description": "Soft deletion flag" },
        "deletedTimestamp": { "type": "integer", "description": "Epoch timestamp of deletion" },
        "updatedAt": { "type": "integer", "description": "Epoch timestamp of last update" }
      },
      "required": ["cloudId", "title", "isCompleted", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks belonging to a specific authenticated user"
    }
  }
}
